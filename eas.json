{
  "cli": {
    "version": ">= 14.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "preview-watch": {
      "distribution": "internal",
      "ios": {
        "buildConfiguration": "Release",
        "credentialsSource": "local"
      },
      "env": {
        "WATCH_PROVISIONING_PROFILE": "Sprout Watch"
      }
    },
    "store-watch": {
      "distribution": "store",
      "ios": {
        "buildConfiguration": "Release",
        "credentialsSource": "local"
      },
      "env": {
        "WATCH_PROVISIONING_PROFILE": "watch_appstore"
      }
    },
    "altstore": {
      "ios": {
        "buildConfiguration": "Release",
        "distribution": "internal"
      },
      "env": {
        "INCLUDE_WATCH_APP": "false"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "richdmartin@me.com",
        "appleTeamId": "66A37BK2N7",
        "ascAppId": "6769972296"
      }
    }
  }
}
